# ==============================================================================
# CampusOS AI - Environment Configuration Example
# Copy this file to .env and configure the values appropriately.
# NEVER commit the actual .env file with secrets to version control.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
APP_NAME="CampusOS AI - Intelligent Campus Scheduling & Venue Management Platform"
APP_VERSION="1.0.0-alpha"

# --- Backend Server Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Database Configuration ---
# Production / Docker: PostgreSQL
# Local Development Fallback: SQLite supported when DATABASE_URL uses sqlite:///
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/campusos_ai
DATABASE_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Security & JWT Authentication ---
# Generate using: openssl rand -hex 32
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- AI Provider Configuration ---
# Supported providers: "openai", "anthropic", "azure", "gemini", "mock"
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL_NAME=gpt-4o
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2048

# --- Solver Configuration (Google OR-Tools CP-SAT) ---
SOLVER_TIME_LIMIT_SECONDS=120
SOLVER_NUM_WORKERS=8
SOLVER_ENABLE_LOGS=False

# --- Frontend Configuration (Public) ---
NEXT_PUBLIC_APP_NAME="CampusOS AI"
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_CAMPUS_NAME="Chilika Institute of Technology"
